{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run_guard.sh\"",
            "statusMessage": "Checking git/GitHub command scope..."
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run_guard.sh\"",
            "statusMessage": "Checking git/GitHub command scope..."
          }
        ]
      }
    ]
  }
}
